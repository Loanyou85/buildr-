# Base de données (PostgreSQL, hébergement UE)
DATABASE_URL="postgresql://postgres@localhost:5432/buildr?schema=public"

# Auth.js v5
AUTH_SECRET="remplace-moi-par-une-valeur-aleatoire"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# E-mail (Resend). Sans clé, les magic links sont écrits dans la console en dev.
AUTH_RESEND_KEY=""
EMAIL_FROM="Buildr <bonjour@buildr.app>"

# IA (appels serveur uniquement, jamais exposée au client)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Administration : e-mails promus role=admin au premier login
ADMIN_EMAILS=""

# Base de données (PostgreSQL, hébergement UE)
DATABASE_URL="postgresql://user:password@host:5432/nexteo"
# Connexion directe, utilisée uniquement par les migrations.
DIRECT_URL="postgresql://user:password@host:5432/nexteo"

# Auth.js v5
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# IA — serveur uniquement, jamais exposée au client.
# Sans clé, le produit fonctionne : le moteur d'idées est déterministe.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL=""

# Stripe. Sans clé, l'écran des offres enregistre l'intention et le dit
# franchement : aucun accès payant n'est ouvert.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_DEPART=""
STRIPE_PRICE_CONSTRUCTION=""
STRIPE_PRICE_LANCEMENT=""

# E-mails
AUTH_RESEND_KEY=""
EMAIL_FROM="Nexteo <bonjour@nexteo.app>"
NEXT_PUBLIC_SUPPORT_EMAIL="bonjour@nexteo.app"

# Administration : adresses promues administrateur à l'inscription.
ADMIN_EMAILS=""

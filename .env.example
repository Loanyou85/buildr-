# Base de données (PostgreSQL, hébergement UE)
# DATABASE_URL : connexion applicative (pooler en production)
# DIRECT_URL   : connexion directe, utilisée par les migrations uniquement.
#                En local, mets la même valeur que DATABASE_URL.
DATABASE_URL="postgresql://postgres@localhost:5432/nexteo?schema=public"
DIRECT_URL="postgresql://postgres@localhost:5432/nexteo?schema=public"

# Auth.js v5
AUTH_SECRET="remplace-moi-par-une-valeur-aleatoire"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# E-mail (Resend), pour les notifications uniquement : la connexion se fait par
# mot de passe et ne dépend d'aucun envoi. Sans clé, les envois vont en console.
AUTH_RESEND_KEY=""
EMAIL_FROM="Nexteo <bonjour@nexteo.app>"

# IA (appels serveur uniquement, jamais exposée au client)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Administration : e-mails promus role=admin au premier login
ADMIN_EMAILS=""

# Paiement (Stripe). Sans STRIPE_SECRET_KEY, choisir une offre payante
# enregistre l'intention et l'annonce : rien n'est débité, aucun accès accordé.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_ILLIMITE=""
